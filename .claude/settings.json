{
  "$comment": "CLAUDE.md §2 的機械保證層。散文只能靠注意力,這裡靠 harness。ask 而非 deny:逃生艙必須留著——每次改 .gd 都跳確認,那個確認就是 §5 說的『被看見的、有意識的選擇』。",
  "permissions": {
    "ask": [
      "Edit(src/**/*.gd)",
      "Write(src/**/*.gd)",
      "Edit(**/*.tscn)",
      "Write(**/*.tscn)",
      "Edit(*.gd)",
      "Edit(**/*.gd)",
      "Edit(*.tscn)",
      "Write(*.gd)",
      "Write(**/*.gd)",
      "Write(*.tscn)"
    ],
    "deny": [
      "Edit(**/*.uid)",
      "Write(**/*.uid)",
      "Edit(**/*.import)",
      "Write(**/*.import)",
      "Edit(.godot/**)",
      "Write(.godot/**)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Write(.env)",
      "Write(.env.*)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Edit(*.uid)",
      "Edit(*.import)",
      "Edit(**/.godot/**)",
      "Write(*.uid)",
      "Write(*.import)",
      "Write(**/.godot/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.harness/claude_hook.py\"",
            "timeout": 180
          }
        ],
        "matcher": "Read|Edit|Write|MultiEdit"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.harness/claude_hook.py\"",
            "timeout": 180
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.harness/claude_hook.py\"",
            "timeout": 180
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.harness/claude_hook.py\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
